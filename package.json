{
  "name": "deliveryzamora",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev:api": "pnpm --filter core-api run start:dev",
    "dev:tracking": "pnpm --filter tracking-service run start:dev",
    "dev:web": "pnpm --filter web run dev",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f docker-compose.infra.yml down",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma",
      "unrs-resolver"
    ]
  }
}
